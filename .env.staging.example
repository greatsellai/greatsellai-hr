# Copy this file to the ignored .env.staging file on the staging host.
#
# Staging is production-equivalent for application features and provider
# credentials, but it is never allowed to source .env.production directly.
# Copy the reviewed production values into this separate file manually, then
# replace only the database password and the topology/callback values marked
# STAGING-ONLY below. Never commit the resulting file.

# The release workflow supplies a full 40-character git commit SHA. Never use
# latest, a branch name, or a production release tag in this field.
RESUME_V3_RELEASE_IMAGE_TAG=replace-with-full-40-character-git-commit-sha

# DATABASE BOUNDARY (STAGING-ONLY): this password belongs only to the isolated
# resume_v3_staging database and must not equal POSTGRES_PASSWORD in production.
RESUME_V3_STAGING_POSTGRES_PASSWORD=replace-with-a-long-random-staging-database-password

# Every value below that is not explicitly labelled STAGING-ONLY must be copied
# from the current production environment exactly, including non-secret knobs.
# This keeps production feature flags, provider selection and resource limits
# faithful in staging. They remain separate copies in this ignored file; do
# not point Compose at .env.production.
RESUME_V3_SESSION_SECRET=copy-the-production-value-here
RESUME_V3_SESSION_COOKIE_SECURE=copy-the-production-value-here

# TOPOLOGY BOUNDARY (STAGING-ONLY): the isolated staging Caddy address.
RESUME_V3_TRUSTED_PROXY_CIDRS=172.31.0.2/32

DEEPSEEK_API_KEY=copy-the-production-value-here
DEEPSEEK_MODEL=copy-the-production-value-here
DEEPSEEK_TIMEOUT_SECONDS=copy-the-production-value-here
RESUME_V3_AI_PROVIDER_CREDENTIALS_JSON=copy-the-production-value-here
RESUME_V3_LEGACY_OPENAI_COMPATIBLE_ENDPOINT=copy-the-production-value-here
TENCENT_SECRET_ID=copy-the-production-value-here
TENCENT_SECRET_KEY=copy-the-production-value-here
TENCENT_OCR_REGION=copy-the-production-value-here
TENCENT_OCR_TIMEOUT_SECONDS=copy-the-production-value-here
OCR_SPARSE_TEXT_CHARS_PER_PAGE=copy-the-production-value-here
RESUME_V3_AI_EXTRACTION_JOB_MAX_ATTEMPTS=copy-the-production-value-here
RESUME_V3_AI_EXTRACTION_JOB_LEASE_SECONDS=copy-the-production-value-here
RESUME_V3_AI_EXTRACTION_WORKER_POLL_SECONDS=copy-the-production-value-here
RESUME_V3_WORKER_CONCURRENCY=copy-the-production-value-here
RESUME_V3_WORKER_DATABASE_POOL_SIZE=copy-the-production-value-here
RESUME_V3_WORKER_DATABASE_MAX_OVERFLOW=copy-the-production-value-here
RESUME_V3_WORKER_WORKSPACE_LANE_LEASE_SECONDS=copy-the-production-value-here

RESUME_V3_MAILBOX_SYNC_INTERVAL_SECONDS=copy-the-production-value-here
RESUME_V3_MAILBOX_RETENTION_CLEANUP_INTERVAL_SECONDS=copy-the-production-value-here
RESUME_V3_MAILBOX_SYNC_ATTACHMENT_LIMIT=copy-the-production-value-here
RESUME_V3_MAILBOX_IMAP_ALLOWED_HOSTS=copy-the-production-value-here
RESUME_V3_MAILBOX_IMAP_CONNECT_TIMEOUT_SECONDS=copy-the-production-value-here
RESUME_V3_MAILBOX_IMAP_MAX_RESOLVED_ADDRESSES=copy-the-production-value-here
RESUME_V3_MAILBOX_OAUTH_STATE_TTL_SECONDS=copy-the-production-value-here
RESUME_V3_MAILBOX_OAUTH_HTTP_TIMEOUT_SECONDS=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_RAW_MESSAGE_BYTES=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_HEADER_BYTES=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_MIME_PARTS=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_MIME_DEPTH=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_ATTACHMENTS_PER_MESSAGE=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_SEARCH_RESPONSE_BYTES=copy-the-production-value-here
RESUME_V3_MAILBOX_MAX_BODY_CACHE_BYTES=copy-the-production-value-here
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_ALERT_THRESHOLD=copy-the-production-value-here
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_WINDOW_SECONDS=copy-the-production-value-here
RESUME_V3_EMAIL_CREDENTIALS_KEY=copy-the-production-value-here
RESUME_V3_MAILBOX_GOOGLE_OAUTH_CLIENT_ID=copy-the-production-value-here
RESUME_V3_MAILBOX_GOOGLE_OAUTH_CLIENT_SECRET=copy-the-production-value-here
# CALLBACK BOUNDARY (STAGING-ONLY): OAuth must return to staging, not prod.
RESUME_V3_MAILBOX_GOOGLE_OAUTH_REDIRECT_URI=https://staging.hr.greatsellai.net/v1/mailbox-oauth/callback
RESUME_V3_MAILBOX_MICROSOFT_OAUTH_CLIENT_ID=copy-the-production-value-here
RESUME_V3_MAILBOX_MICROSOFT_OAUTH_CLIENT_SECRET=copy-the-production-value-here
RESUME_V3_MAILBOX_MICROSOFT_OAUTH_REDIRECT_URI=https://staging.hr.greatsellai.net/v1/mailbox-oauth/callback

RESUME_V3_TRANSACTIONAL_EMAIL_PROVIDER=copy-the-production-value-here
RESUME_V3_TRANSACTIONAL_EMAIL_FROM=copy-the-production-value-here
# PUBLIC-URL BOUNDARY (STAGING-ONLY): generated email links must open staging.
RESUME_V3_STAGING_PUBLIC_APP_URL=https://staging.hr.greatsellai.net
TENCENT_SES_REGION=copy-the-production-value-here
TENCENT_SES_VERIFICATION_TEMPLATE_ID=copy-the-production-value-here
