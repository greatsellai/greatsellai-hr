# Keep real secrets out of this repository.
RESUME_V3_ADMIN_TOKEN=replace-with-a-long-random-token
RESUME_V3_DATABASE_URL=sqlite:///./data/resume_v3.db
RESUME_V3_ENVIRONMENT=development
# Local SQLite development can bootstrap automatically. Cloud production must
# set both values to 0 and run: alembic upgrade head && python -m app.seed_institutions
RESUME_V3_AUTO_CREATE_SCHEMA=1
RESUME_V3_SEED_REGISTRY_ON_STARTUP=1
RESUME_V3_DATABASE_POOL_SIZE=5
RESUME_V3_DATABASE_MAX_OVERFLOW=10
# Leave empty for direct local development. Production Compose supplies its
# fixed Caddy /32 and rejects an empty or catch-all trusted proxy range.
RESUME_V3_TRUSTED_PROXY_CIDRS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
# Generic platform Providers keep only a non-secret credential_ref in the
# database. Map that reference to the actual server-only secret here.
RESUME_V3_AI_PROVIDER_CREDENTIALS_JSON={}
RESUME_V3_LEGACY_OPENAI_COMPATIBLE_ENDPOINT=https://api.deepseek.com/beta/chat/completions
# Optional OCR fallback for pages whose native text is suspiciously sparse.
# Keep these values only in the server-side .env file, never in the frontend.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_TIMEOUT_SECONDS=20
OCR_SPARSE_TEXT_CHARS_PER_PAGE=500
# The API only queues extraction; this durable worker performs model calls.
RESUME_V3_AI_EXTRACTION_JOB_MAX_ATTEMPTS=3
RESUME_V3_AI_EXTRACTION_JOB_LEASE_SECONDS=180
RESUME_V3_AI_EXTRACTION_WORKER_POLL_SECONDS=2
# IMAP is configured in the authenticated UI. The optional key is used to
# encrypt its authorization code at rest; when empty, SESSION_SECRET is used.
RESUME_V3_MAILBOX_SYNC_INTERVAL_SECONDS=600
RESUME_V3_MAILBOX_SYNC_ATTACHMENT_LIMIT=20
# Deployment-owned exact IMAPS host names only. Do not use wildcards, IP
# addresses, private hosts, or custom ports from a workspace form.
RESUME_V3_MAILBOX_IMAP_ALLOWED_HOSTS=imap.feishu.cn
RESUME_V3_MAILBOX_IMAP_CONNECT_TIMEOUT_SECONDS=10
RESUME_V3_MAILBOX_IMAP_MAX_RESOLVED_ADDRESSES=8
# Resource ceilings apply before MIME parsing and attachment extraction.
RESUME_V3_MAILBOX_MAX_RAW_MESSAGE_BYTES=25165824
RESUME_V3_MAILBOX_MAX_HEADER_BYTES=131072
RESUME_V3_MAILBOX_MAX_MIME_PARTS=64
RESUME_V3_MAILBOX_MAX_MIME_DEPTH=16
RESUME_V3_MAILBOX_MAX_ATTACHMENTS_PER_MESSAGE=5
RESUME_V3_MAILBOX_MAX_SEARCH_RESPONSE_BYTES=1048576
RESUME_V3_MAILBOX_MAX_BODY_CACHE_BYTES=262144
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_ALERT_THRESHOLD=3
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_WINDOW_SECONDS=3600
RESUME_V3_EMAIL_CREDENTIALS_KEY=
