(common_api) {
    @api path /v1 /v1/*
    handle @api {
        reverse_proxy api:8000
    }

    @health path /health
    handle @health {
        reverse_proxy api:8000
    }
}

(frontend) {
    root * /srv
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
}

{$RESUME_V3_DOMAIN} {
    encode zstd gzip

    # A future root-site edge may proxy the legacy compatibility paths to this
    # host while retaining ownership of greatsellai.net itself.
    @compat_api path /greatsellhr/v1 /greatsellhr/v1/*
    handle @compat_api {
        uri strip_prefix /greatsellhr
        reverse_proxy api:8000
    }

    @compat_health path /greatsellhr/health
    handle @compat_health {
        uri strip_prefix /greatsellhr
        reverse_proxy api:8000
    }

    import common_api

    handle {
        import frontend
    }
}
