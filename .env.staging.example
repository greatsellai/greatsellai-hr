# Copy this file to an ignored .env.staging file on the staging host.
# It intentionally contains no production credential, candidate data, mailbox
# authorization, or AI/OCR key. Use values generated specifically for staging.

# The release workflow supplies a full 40-character git commit SHA. Never use
# latest, a branch name, or a production release tag in this field.
RESUME_V3_RELEASE_IMAGE_TAG=replace-with-full-40-character-git-commit-sha

# Required, staging-only secrets. Generate different values from production.
RESUME_V3_STAGING_POSTGRES_PASSWORD=replace-with-a-long-random-staging-database-password
RESUME_V3_STAGING_ADMIN_TOKEN=replace-with-a-long-random-staging-admin-token
RESUME_V3_STAGING_SESSION_SECRET=replace-with-a-long-random-staging-session-secret
RESUME_V3_STAGING_SESSION_COOKIE_SECURE=1

# The public staging hostname is terminated by the production Caddy gateway;
# this compose stack itself binds only 172.17.0.1:18080 over HTTP.
RESUME_V3_STAGING_PUBLIC_APP_URL=https://staging.hr.greatsellai.net

# Keep external side effects disabled in staging. The compose file hardcodes
# empty AI/OCR/mail credentials and a disabled transactional-email provider.
# These settings only tune local job scheduling and resource use.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_TIMEOUT_SECONDS=20
OCR_SPARSE_TEXT_CHARS_PER_PAGE=500
RESUME_V3_AI_EXTRACTION_JOB_MAX_ATTEMPTS=3
RESUME_V3_AI_EXTRACTION_JOB_LEASE_SECONDS=180
RESUME_V3_AI_EXTRACTION_WORKER_POLL_SECONDS=10
RESUME_V3_MAILBOX_SYNC_INTERVAL_SECONDS=86400
RESUME_V3_MAILBOX_RETENTION_CLEANUP_INTERVAL_SECONDS=86400
# Must remain at least 1 because application validation rejects 0.
RESUME_V3_MAILBOX_SYNC_ATTACHMENT_LIMIT=1

# Optional non-secret safety limits. Keep them conservative for the shared
# same-host staging server.
RESUME_V3_MAILBOX_IMAP_CONNECT_TIMEOUT_SECONDS=10
RESUME_V3_MAILBOX_IMAP_MAX_RESOLVED_ADDRESSES=8
RESUME_V3_MAILBOX_OAUTH_STATE_TTL_SECONDS=600
RESUME_V3_MAILBOX_OAUTH_HTTP_TIMEOUT_SECONDS=20
RESUME_V3_MAILBOX_MAX_RAW_MESSAGE_BYTES=25165824
RESUME_V3_MAILBOX_MAX_HEADER_BYTES=131072
RESUME_V3_MAILBOX_MAX_MIME_PARTS=64
RESUME_V3_MAILBOX_MAX_MIME_DEPTH=16
RESUME_V3_MAILBOX_MAX_ATTACHMENTS_PER_MESSAGE=5
RESUME_V3_MAILBOX_MAX_SEARCH_RESPONSE_BYTES=1048576
RESUME_V3_MAILBOX_MAX_BODY_CACHE_BYTES=262144
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_ALERT_THRESHOLD=3
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_WINDOW_SECONDS=3600
TENCENT_SES_REGION=ap-guangzhou
