# Copy to .env.production on the server. Never commit the copied file.
RESUME_V3_DOMAIN=hr.greatsellai.cn
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
RESUME_V3_SESSION_SECRET=replace-with-a-different-long-random-session-secret
# One-time legacy static-auth handoff. Leave blank for normal deployments.
# If a historical database has recruiting data but no verified platform admin,
# set this to the UUID of one existing, active, verified account chosen by the
# deployment owner. It is injected into the migrate container only; remove it
# after that migration succeeds. Never put an email or password here.
RESUME_V3_LEGACY_WORKSPACE_ADOPTION_USER_ID=
# Compose gives Caddy this fixed private address on its dedicated proxy
# network. Keep this exact /32: do not use 0.0.0.0/0 or a public CIDR, or a
# caller could spoof X-Forwarded-For and evade public-auth rate limits.
RESUME_V3_TRUSTED_PROXY_CIDRS=172.30.0.2/32
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
# Generic platform Provider credentials. Keys must exactly match the
# credential_ref saved in the platform console; values are real secrets only
# in the ignored .env.production file and are never submitted through the UI.
RESUME_V3_AI_PROVIDER_CREDENTIALS_JSON={}
RESUME_V3_LEGACY_OPENAI_COMPATIBLE_ENDPOINT=https://api.deepseek.com/beta/chat/completions
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_TIMEOUT_SECONDS=20
OCR_SPARSE_TEXT_CHARS_PER_PAGE=500
RESUME_V3_AI_EXTRACTION_JOB_MAX_ATTEMPTS=3
RESUME_V3_AI_EXTRACTION_JOB_LEASE_SECONDS=180
RESUME_V3_AI_EXTRACTION_WORKER_POLL_SECONDS=2
# One shared worker container can run a small pool of isolated child processes.
# Start at 2 only after PostgreSQL migrations and seeds are complete; fairness
# still allows one heavy task at a time per workspace.
RESUME_V3_WORKER_CONCURRENCY=1
RESUME_V3_WORKER_DATABASE_POOL_SIZE=1
RESUME_V3_WORKER_DATABASE_MAX_OVERFLOW=0
RESUME_V3_WORKER_WORKSPACE_LANE_LEASE_SECONDS=210
RESUME_V3_MAILBOX_SYNC_INTERVAL_SECONDS=600
RESUME_V3_MAILBOX_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
RESUME_V3_MAILBOX_SYNC_ATTACHMENT_LIMIT=20
RESUME_V3_MAILBOX_IMAP_ALLOWED_HOSTS=imap.feishu.cn
RESUME_V3_MAILBOX_IMAP_CONNECT_TIMEOUT_SECONDS=10
RESUME_V3_MAILBOX_IMAP_MAX_RESOLVED_ADDRESSES=8
RESUME_V3_MAILBOX_OAUTH_STATE_TTL_SECONDS=600
RESUME_V3_MAILBOX_OAUTH_HTTP_TIMEOUT_SECONDS=20
RESUME_V3_MAILBOX_MAX_RAW_MESSAGE_BYTES=25165824
RESUME_V3_MAILBOX_MAX_HEADER_BYTES=131072
RESUME_V3_MAILBOX_MAX_MIME_PARTS=64
RESUME_V3_MAILBOX_MAX_MIME_DEPTH=16
RESUME_V3_MAILBOX_MAX_ATTACHMENTS_PER_MESSAGE=5
RESUME_V3_MAILBOX_MAX_SEARCH_RESPONSE_BYTES=1048576
RESUME_V3_MAILBOX_MAX_BODY_CACHE_BYTES=262144
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_ALERT_THRESHOLD=3
RESUME_V3_MAILBOX_CONSECUTIVE_FAILURE_WINDOW_SECONDS=3600
RESUME_V3_EMAIL_CREDENTIALS_KEY=
# OAuth client metadata for the reviewed Gmail/Microsoft mailbox providers.
# Keep client secrets only in the ignored production environment file.
RESUME_V3_MAILBOX_GOOGLE_OAUTH_CLIENT_ID=
RESUME_V3_MAILBOX_GOOGLE_OAUTH_CLIENT_SECRET=
RESUME_V3_MAILBOX_GOOGLE_OAUTH_REDIRECT_URI=https://hr.greatsellai.cn/v1/mailbox-oauth/callback
RESUME_V3_MAILBOX_MICROSOFT_OAUTH_CLIENT_ID=
RESUME_V3_MAILBOX_MICROSOFT_OAUTH_CLIENT_SECRET=
RESUME_V3_MAILBOX_MICROSOFT_OAUTH_REDIRECT_URI=https://hr.greatsellai.cn/v1/mailbox-oauth/callback
# Transactional account email. To use Tencent SES, set provider to
# tencent_ses, use a verified sender/domain, and provide two separately
# approved templates. Both templates receive token and expires_minutes; each
# template must keep its public domain and route fixed, using {{token}} only
# as the query value. Real Tencent credentials stay only in this ignored file.
RESUME_V3_TRANSACTIONAL_EMAIL_PROVIDER=disabled
RESUME_V3_TRANSACTIONAL_EMAIL_FROM=
RESUME_V3_PUBLIC_APP_URL=https://hr.greatsellai.cn
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_VERIFICATION_TEMPLATE_ID=
TENCENT_SES_PASSWORD_RESET_TEMPLATE_ID=
# Legacy temporary sender. Keep it blank when RESUME_V3_TRANSACTIONAL_EMAIL_PROVIDER
# is tencent_ses; never commit an SMTP application password.
RESUME_V3_FEISHU_SMTP_HOST=smtp.feishu.cn
RESUME_V3_FEISHU_SMTP_PORT=465
RESUME_V3_FEISHU_SMTP_TLS_MODE=ssl
RESUME_V3_FEISHU_SMTP_USERNAME=
RESUME_V3_FEISHU_SMTP_PASSWORD=
RESUME_V3_FEISHU_SMTP_TIMEOUT_SECONDS=20
